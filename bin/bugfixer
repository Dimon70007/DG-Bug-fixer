#!/usr/bin/env python3
"""The bug-fixer plugin's single entry point.

One command instead of relative script paths: an installed plugin is executed from a
project's working directory, where ``python3 hooks/…`` resolves to nothing. Stage 3 adds the
``gate``/``state``/``secrets`` verbs to this file; stage 2 ships ``doctor``, because a
contract nobody can validate is a contract that silently disables the gate.

    bugfixer doctor [--project <dir>]     # is this project's contract usable?

Exit codes: ``0`` usable (warnings allowed), ``2`` refused or invalid input.
"""

from __future__ import annotations

import argparse
import sys
from pathlib import Path
from typing import Final

# The plugin root is this file's grandparent: ``bin/bugfixer`` -> ``<plugin>``. Taken from the
# file rather than from the working directory, because the agent's cwd is the project.
PLUGIN_ROOT: Final[Path] = Path(__file__).resolve().parent.parent
if str(PLUGIN_ROOT / "lib") not in sys.path:
    sys.path.insert(0, str(PLUGIN_ROOT / "lib"))

from bugfixer import contract  # noqa: E402
from bugfixer import readiness  # noqa: E402
from bugfixer import rules  # noqa: E402

EXIT_OK: Final[int] = 0
EXIT_REFUSED: Final[int] = 2


def _doctor(project: Path) -> int:
    """Check the project's contract and report what the gate would do with it.

    The check itself lives in :mod:`bugfixer.readiness`, which the session-start hook also asks.
    Two implementations of "is this project ready" would eventually answer differently, and the
    agent would be told "you are fine" by one and refused by the other.

    Args:
        project: Project directory to inspect.

    Returns:
        ``0`` when the contract's fields are usable, ``2`` when it is missing or incomplete.
    """
    state = readiness.inspect(project)
    if state.contract is None:
        print(
            f"no {contract.CONTRACT_NAME} at or above {state.project.resolve()}. Phase 0 of the "
            "skill stops and asks for one; it does not guess a test command or a ledger path.",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    for warning in state.warnings:
        print(f"warning: {warning}", file=sys.stderr)
    if state.problems:
        print(f"{state.contract}: not usable", file=sys.stderr)
        for problem in state.problems:
            print(f"  - {problem}", file=sys.stderr)
        return EXIT_REFUSED

    print(f"{state.contract}: ok")
    print(f"  ledger pattern : {state.ledger_pattern}")
    print(f"  test paths     : {', '.join(state.test_paths)}")
    # The resolved ledger is reported because doctor and the gate used to disagree about it:
    # a contract could pass validation and still leave the gate with nothing to enforce.
    if state.ledger is not None:
        print(f"  ledger         : {state.ledger}")
    else:
        print("  ledger         : not matched yet")
        if state.ledger_problem:
            # Not a failure: no run is under way until a task file exists. The reason is printed
            # because the gate refuses every write until one does, and "ok" alone would hide that.
            print(f"  {state.ledger_problem}", file=sys.stderr)
    return EXIT_OK


def _init(project: Path, *, force: bool) -> int:
    """Write a starting contract for a project.

    Args:
        project: Project directory to scaffold.
        force: Replace an existing contract. Off by default: a filled contract holds decisions
            that must not be destroyed by a repeated command.

    Returns:
        ``0`` when the file was written, ``2`` when it was refused.
    """
    target = project / contract.CONTRACT_NAME
    if target.exists() and not force:
        print(
            f"{target} already exists. It holds this project's decisions, so it is not "
            "replaced by a default. Edit it and run `bugfixer doctor`; pass --force only if "
            "you really mean to start again.",
            file=sys.stderr,
        )
        return EXIT_REFUSED

    contract.write_created(target, contract.scaffold(project))
    print(f"{target}: written")
    # The rule is the main initialisation channel (§18.3), and `init` is what a plugin-only
    # install has: a plugin from a marketplace never runs `install.py`. Writing it here is what
    # keeps "the plugin tells the agent to check first" true without a hook.
    for merged in rules.install(project):
        if merged.action != "kept":
            print(f"  {merged.path} ({merged.action}: project rule — the main init channel)")
    added = contract.ensure_gitignore(project)
    if added:
        print(f"  .gitignore: added {', '.join(added)} (the run journal is local history)")
    remaining = contract.problems(target.read_text(encoding="utf-8"))
    if remaining:
        print(f"  {len(remaining)} field(s) still need a value:", file=sys.stderr)
        for problem in remaining:
            print(f"    - {problem}", file=sys.stderr)
    pattern = contract.ledger_pattern(target.read_text(encoding="utf-8"))
    if pattern and not list(project.glob(pattern)):
        print(
            f"  note: `{pattern}` matches no file yet. Until one exists the gate cannot find a "
            "ledger and refuses work, so create the task file for this bug first.",
            file=sys.stderr,
        )
    print("  Confirm these against your own runtime before trusting them:")
    for item in contract.AGENT_CONFIRMS:
        print(f"    - {item}")
    print(
        "  Then run `bugfixer doctor` until it exits 0 — the gate refuses work until then."
    )
    return EXIT_OK


def main(argv: list[str] | None = None) -> int:
    """Parse arguments and dispatch.

    Args:
        argv: Argument list; defaults to ``sys.argv[1:]``.

    Returns:
        Process exit code.
    """
    parser = argparse.ArgumentParser(
        prog="bugfixer",
        description="bug-fixer plugin commands: `init` creates the project contract, "
        "`doctor` validates it.",
    )
    sub = parser.add_subparsers(dest="verb", required=True)

    init = sub.add_parser("init", help="write a starting project contract")
    init.add_argument(
        "--project",
        default=".",
        help="project directory to scaffold (default: the current directory)",
    )
    init.add_argument(
        "--force",
        action="store_true",
        help="replace an existing contract; it holds this project's decisions",
    )

    doctor = sub.add_parser("doctor", help="validate the project contract")
    doctor.add_argument(
        "--project",
        default=".",
        help="project directory to inspect (default: the current directory)",
    )
    args = parser.parse_args(argv)

    if args.verb in {"init", "doctor"}:
        project = Path(args.project).expanduser()
        if not project.is_dir():
            print(f"bugfixer: --project {project} is not a directory", file=sys.stderr)
            return EXIT_REFUSED

    if args.verb == "init":
        return _init(project, force=args.force)
    if args.verb == "doctor":
        return _doctor(project)
    parser.error(f"unknown verb {args.verb!r}")
    return EXIT_REFUSED


if __name__ == "__main__":
    raise SystemExit(main())
